<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tennis_bot">

  <xacro:include filename="$(find tennis_bot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find tennis_bot_description)/urdf/gazebo_control.xacro"/>
  <xacro:include filename="$(find tennis_bot_description)/urdf/gazebo_sensors.xacro"/>


  <!-- Robot parameters -->

  <xacro:property name="base_length" value="0.50"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.12"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.42"/>

  <xacro:property name="camera_x" value="0.18"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.24"/>
  <xacro:property name="lidar_z" value="0.20"/>


  <!-- Inertia helper macros -->

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (3*radius*radius + length*length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (3*radius*radius + length*length) / 12.0}"
        iyz="0.0"
        izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${0.4 * mass * radius * radius}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.4 * mass * radius * radius}"
        iyz="0.0"
        izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- Base -->

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="5.0"
      x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2.0}" rpy="0 0 0"/>
  </joint>


  <!-- Left wheel -->

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.40" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_separation/2.0} ${-base_height/2.0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- Right wheel -->

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.40" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_separation/2.0} ${-base_height/2.0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- Support casters -->

  <link name="front_caster_link">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
    <xacro:sphere_inertia mass="0.15" radius="0.035"/>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.19 0 -0.105" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster_link">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
    <xacro:sphere_inertia mass="0.15" radius="0.035"/>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.19 0 -0.105" rpy="0 0 0"/>
  </joint>


  <!-- RGB-D camera -->

  <link name="camera_link">
    <visual>
      <geometry><box size="0.08 0.08 0.05"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.05"/></geometry>
    </collision>
    <xacro:box_inertia mass="0.15" x="0.08" y="0.08" z="0.05"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- ROS optical-frame convention: x right, y down, z forward. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>


  <!-- LiDAR -->

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.10" radius="0.045" length="0.04"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- IMU-->

  <link name="imu_link">
    <visual>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
    </collision>
    <xacro:box_inertia mass="0.05" x="0.04" y="0.04" z="0.02"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.10 0 0.08" rpy="0 0 0"/>
  </joint>

  <xacro:tennis_bot_control
    left_joint="left_wheel_joint"
    right_joint="right_wheel_joint"/>

  <gazebo reference="front_caster_link">
	  <mu1>0.0</mu1>
	  <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="rear_caster_link">
	  <mu1>0.0</mu1>
	  <mu2>0.0</mu2>
  </gazebo>

</robot>
