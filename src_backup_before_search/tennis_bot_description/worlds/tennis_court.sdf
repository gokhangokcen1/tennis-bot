<?xml version="1.0"?>
<sdf version="1.7">
  <world name="tennis_court">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <model name="court_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 5.0 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 5.0 0.10</size></box></geometry>
          <material>
            <ambient>0.15 0.40 0.12 1</ambient>
            <diffuse>0.15 0.40 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 2.55 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.2 0.10 0.40</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.10 0.40</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.55 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.2 0.10 0.40</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.10 0.40</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.05 0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 5.0 0.40</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 5.0 0.40</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.05 0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 5.0 0.40</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 5.0 0.40</size></box></geometry></visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>0.8 0.9 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.7 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.7 0.70</size></box></geometry></visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>-0.9 -0.9 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.9 0.60</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.9 0.60</size></box></geometry></visual>
      </link>
    </model>

    <!-- Targets: visual-only so they don't become navigation obstacles. -->
    <model name="ball_1">
      <static>true</static><pose>1.8 1.4 0.06 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.45 0.80 0.05 1</ambient><diffuse>0.45 0.80 0.05 1</diffuse></material>
      </visual></link>
    </model>

    <model name="ball_2">
      <static>true</static><pose>2.2 -1.1 0.06 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.45 0.80 0.05 1</ambient><diffuse>0.45 0.80 0.05 1</diffuse></material>
      </visual></link>
    </model>

    <model name="ball_3">
      <static>true</static><pose>-1.8 1.1 0.06 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.45 0.80 0.05 1</ambient><diffuse>0.45 0.80 0.05 1</diffuse></material>
      </visual></link>
    </model>

    <model name="ball_4">
      <static>true</static><pose>-2.3 -1.3 0.06 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.45 0.80 0.05 1</ambient><diffuse>0.45 0.80 0.05 1</diffuse></material>
      </visual></link>
    </model>

  </world>
</sdf>
